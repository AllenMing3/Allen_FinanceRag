# ===================== Mock 模式 =====================
# 启用后所有外部 API 返回模拟数据，无需 API Key 即可开发测试
MOCK_MODE=false

# ===================== 阿里百炼 DashScope =====================
# 获取 API Key: https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# ===================== Tushare =====================
# 获取 Token: https://tushare.pro/register?reg=7
TUSHARE_TOKEN=your_tushare_token_here

# ===================== 可选：OpenAI 兼容模式 =====================
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# OPENAI_API_BASE=https://api.openai.com/v1

# ===================== 可观测性：Arize Phoenix =====================
# 默认关闭：关闭时埋点走 no-op，零副作用、不联网，不影响离线测试。
# 启用前先装重依赖：pip install -r requirements-observability.txt
PHOENIX_ENABLED=false
# Phoenix collector/UI 端点（进程内 launch_app 默认 6006）
PHOENIX_ENDPOINT=http://localhost:6006
# trace 归属的项目名
PHOENIX_PROJECT=financial-rag
