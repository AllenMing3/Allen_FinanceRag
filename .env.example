# ===================== Mock 模式 =====================
# 启用后所有外部 API 返回模拟数据，无需 API Key 即可开发测试
MOCK_MODE=false

# ===================== 阿里百炼 DashScope =====================
# 获取 API Key: https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# ===================== Tushare =====================
# 获取 Token: https://tushare.pro/register?reg=7
TUSHARE_TOKEN=your_tushare_token_here

# ===================== 可选：OpenAI 兼容模式 =====================
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# OPENAI_API_BASE=https://api.openai.com/v1

# ===================== 可观测性：Arize Phoenix（隔离 + OTLP 外推）=====================
# 默认关闭：关闭时埋点走 no-op，零副作用、不联网，不影响离线测试。
# 架构：Phoenix 服务隔离在独立 .venv-obs（勿装进主环境）；主应用只经 OTLP/HTTP 把 span 推过去。
#   1) 起 Phoenix 服务（独立环境，监听 6006，含 OTLP collector）：scripts/start_phoenix.ps1 | .sh
#   2) 主环境装 OTLP 导出器：uv sync --extra observability
PHOENIX_ENABLED=false
# 外部独立 phoenix serve 的 collector/UI 端点（主应用把 span 推到 <endpoint>/v1/traces）
PHOENIX_ENDPOINT=http://localhost:6006
# trace 归属的项目名
PHOENIX_PROJECT=financial-rag
