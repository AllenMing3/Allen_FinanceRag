# ===================== 密钥 & 环境变量 — 绝对不能提交 =====================
.env
*.env
!*.env.example
*.pem
*.key
*.crt
credentials.json
service-account.json
secrets.yaml
secrets.yml

# ===================== Python =====================
# 虚拟环境
myenv/
venv/
env/
.venv/
.venv-obs/
ENV/

