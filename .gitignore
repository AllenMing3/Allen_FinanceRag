data/**/*.pdf
data/**/*.csv
data/**/*.parquet
data/**/*.db
data/**/*.sqlite3

# 但保留样本数据
!data/**/*.jsonl
!data/**/*.json

# 日志
*.log
logs/

# 运行时数据
.runtime/
output/
dump/

