!.codebuddy/automations/

# Sublime / Vim / Emacs
*.sublime-*
*.swp
*.swo
*~
\#*\#
.\#*

# ===================== Windows 特有 =====================
# 缩略图缓存
Thumbs.db
ehthumbs.db

