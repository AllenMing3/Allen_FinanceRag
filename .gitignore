.ipynb_checkpoints/
*.ipynb

# 测试
.pytest_cache/
.coverage
htmlcov/
.tox/
*.cover

# ===================== IDE & 编辑器 =====================
# VS Code
.vscode/
*.code-workspace

# PyCharm
.idea/
*.iml

# Cursor / CodeBuddy（保留 automations，不提交 session 数据）
.codebuddy/*
!.codebuddy/automations/

# Sublime / Vim / Emacs
*.sublime-*
*.swp
*.swo
*~
\#*\#
.\#*

# ===================== Windows 特有 =====================
# 缩略图缓存
Thumbs.db
ehthumbs.db

# 文件夹图标
Desktop.ini

# Windows 回收站
$RECYCLE.BIN/

# ===================== macOS =====================
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# ===================== Linux =====================
.directory
*~

# ===================== 项目数据（按需调整） =====================
# 本地数据文件 — 如果很大就别提交，用小样本代替
data/**/*.pdf
data/**/*.csv
data/**/*.parquet
data/**/*.db
data/**/*.sqlite3

# 但保留样本数据（source/ 层的 json/jsonl 真相源）
!data/**/*.jsonl
!data/**/*.json

# 日志
*.log
logs/

# 运行时数据
.runtime/
output/
dump/

# 临时测试/草稿文件
case1
tmp/
temp/
*.tmp

# ===================== 运行时产物 & 一次性脚本（保持 git status 清爽）=====================
# KB 分层：index/(派生索引·可删重建) + state/(运行状态·每次运行都变) 不入库；
#          source/(真相源·不可再生) 保留追踪。目录级忽略，新增派生文件自动覆盖。
data/knowledge_base/index/
data/knowledge_base/state/
# 备份文件（persistence 单代 .bak 机制自动生成于各层）
data/knowledge_base/**/*.bak
data/knowledge_base/**/*.bak_pre_clean

# 实验/评估产物（脚本生成，可复现）
experiments/lightrag_demo/
experiments/ragas_results.json

# 根目录一次性脚本 & 临时转储（下划线前缀 = 临时约定；不影响已 track 的文件）
/_*.py
/_*.txt
/tmp.txt
/review_diff.txt
